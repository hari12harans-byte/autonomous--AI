# --- LLM provider ---
# mock      -> deterministic offline provider, no key needed (default, demo-safe)
# groq      -> FREE, no credit card needed: console.groq.com
# openai    -> requires OPENAI_API_KEY (no free tier as of 2026)
# anthropic -> requires ANTHROPIC_API_KEY (no free tier as of 2026)
# ollama    -> requires local Ollama server (OLLAMA_HOST)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Research ---
# offline -> uses a built-in stub knowledge snippet generator, no internet needed
# web     -> uses httpx to fetch/scan configured RESEARCH_SOURCE_URLS
RESEARCH_MODE=offline
RESEARCH_SOURCE_URLS=https://en.wikipedia.org,https://arstechnica.com,https://www.nature.com

# --- Pipeline ---
PIPELINE_INTERVAL_MINUTES=15
MAX_CONTENT_REVISIONS=2
LLM_RATE_LIMIT_PER_MIN=20
TOPIC_SIMILARITY_DEDUP_THRESHOLD=0.86

# --- Storage ---
DATABASE_URL=sqlite:///./data/agent.db
CHROMA_PERSIST_DIR=./data/chroma

# --- API ---
API_RATE_LIMIT_PER_MIN=60
LOG_LEVEL=INFO
